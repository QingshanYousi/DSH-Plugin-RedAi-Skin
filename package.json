{
  "name": "dsh-plugin-redai-skin",
  "version": "0.1.0",
  "icon": "./icon.svg",
  "description": "Redai 皮肤 — 基于官方主题 token 的皮肤管理：配色 / 形状 / 字体预设，可导入导出皮肤包",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./assets/*": "./assets/*"
  },
  "files": [
    "lib",
    "icon.svg",
    "assets",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "dsh-plugin",
    "dsh",
    "redai",
    "theme",
    "skin"
  ],
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "peerDependencies": {
    "react": ">=18.2.0 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dsh": {
    "plugin": true,
    "kind": "client",
    "manifestVersion": 1,
    "bundle": {
      "patch": [
        "./cordis.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "disclosure": {
      "cloud": false,
      "network": [],
      "offlineMode": true,
      "apiKeys": [],
      "permissions": [
        "network:none",
        "filesystem:none",
        "env:none",
        "renderer-only",
        "storage:localStorage"
      ],
      "jurisdiction": [
        "PIPL"
      ],
      "retention": "none"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/QingshanYousi/DSH-Plugin-RedAi-Skin.git"
  },
  "homepage": "https://github.com/QingshanYousi/DSH-Plugin-RedAi-Skin#readme",
  "bugs": {
    "url": "https://github.com/QingshanYousi/DSH-Plugin-RedAi-Skin/issues"
  }
}
